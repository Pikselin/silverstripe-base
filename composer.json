{
    "name": "pikselin/silverstripe-base",
    "type": "silverstripe-vendormodule",
    "description": "Add core config and options",
    "keywords": [
        "silverstripe",
        "admin"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Pikselin dev",
            "homepage": "https://github.com/Pikselin",
            "role": "Developer"
        }
    ],
    "require": {
        "silverstripe/cms": "^6.1.0",
        "silverstripe/framework": "^6.1.3",

        "purplespider/asset-alt-text": "^3.0.0",
        "heyday/silverstripe-responsive-images": "^4.0.0",
        "jonom/focuspoint": "^6.0.0",
        "stevie-mayhew/silverstripe-svg": "^3.0.0",
        "silverstripe/redirectedurls": "^4.0.0",
        "tractorcow/silverstripe-robots": "^5.0.0",
        "colymba/gridfield-bulk-editing-tools": "^5.1.0",
        "symbiote/silverstripe-gridfieldextensions": "^5.1.0",
        "axllent/silverstripe-email-obfuscator": "^2.1.1",
        "silverstripe/mimevalidator": "^4.0.0",
        "silverstripe/mfa": "^6.1.0",
        "unclecheese/silverstripe-cms-theme": "dev-master",
        "lekoala/silverstripe-cms-actions": "^2.0.0",
        "undefinedoffset/sortablegridfield": "^3.0.2",

        "silverstripe/crontask": "^4.0.0",
        "plastyk/dashboard": "^5.0.1",
        "silverstripe/sharedraftcontent": "^4.1.0",
        "silverstripe/environmentcheck": "^4.1.0"
    },
    "require-dev": {
        "dnadesign/silverstripe-populate": "^4.0.0"
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "expose": [
            "client"
        ],
        "project-files-installed": [
            ".editorconfig",
            ".php-cs-fixer.php",
            "app/.htaccess",
            "app/_config.php",
            "app/_config/dev.yml",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php",
            "phpstan.neon",
            "themes/pikselin/composer.json",
            "themes/pikselin/package.json",
            "themes/pikselin/webpack.mix.js"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "autoload": {
        "psr-4": {
            "Pikselin\\Extensions\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
